<Window x:Class="StreamAssistant2.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Stream Assistant"
		Icon="/icon.ico"
		Width="1600" Height="900"
		Background="#0C0C0C"
		FontFamily="Consolas" FontSize="13">
	<Window.Resources>
		<Style x:Key="ScrollThumb" TargetType="Thumb">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Border x:Name="Bar" Background="#3E3E3E" />
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bar" Property="Background" Value="#4E4E4E" />
							</Trigger>
							<Trigger Property="IsDragging" Value="True">
								<Setter TargetName="Bar" Property="Background" Value="#5E5E5E" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ScrollPage" TargetType="RepeatButton">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RepeatButton">
						<Border Background="Transparent" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="ScrollBar">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Width" Value="10" />
			<Setter Property="MinWidth" Value="10" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Border Background="{TemplateBinding Background}">
							<Track x:Name="PART_Track" IsDirectionReversed="True">
								<Track.DecreaseRepeatButton>
									<RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb Style="{StaticResource ScrollThumb}" Margin="2,0" />
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
								</Track.IncreaseRepeatButton>
							</Track>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="Orientation" Value="Horizontal">
					<Setter Property="Width" Value="Auto" />
					<Setter Property="MinWidth" Value="0" />
					<Setter Property="Height" Value="10" />
					<Setter Property="MinHeight" Value="10" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ScrollBar">
								<Border Background="{TemplateBinding Background}">
									<Track x:Name="PART_Track">
										<Track.DecreaseRepeatButton>
											<RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
										</Track.DecreaseRepeatButton>
										<Track.Thumb>
											<Thumb Style="{StaticResource ScrollThumb}" Margin="0,2" />
										</Track.Thumb>
										<Track.IncreaseRepeatButton>
											<RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
										</Track.IncreaseRepeatButton>
									</Track>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="DropDownToggle" TargetType="ToggleButton">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="ClickMode" Value="Press" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="Box" Background="#1E1E1E" BorderBrush="#3E3E3E" BorderThickness="1">
							<Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#888888" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Box" Property="Background" Value="#2A2A2A" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Box" Property="Background" Value="#2A2A2A" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="ComboBox">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Foreground" Value="#CCCCCC" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton Style="{StaticResource DropDownToggle}"
										  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
							<ContentPresenter Margin="6,2,22,2" VerticalAlignment="Center" IsHitTestVisible="False"
											  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
							<Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
								   PopupAnimation="None">
								<Border Background="#1E1E1E" BorderBrush="#3E3E3E" BorderThickness="1"
										MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
									<ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
										<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="ComboBoxItem">
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Foreground" Value="#CCCCCC" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBoxItem">
						<Border x:Name="Item" Background="Transparent" Padding="6,1">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="Item" Property="Background" Value="#2A2A2A" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Foreground" Value="#EE8844" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<DockPanel>
		<Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="6,4" BorderBrush="#333333" BorderThickness="0,0,0,1">
			<StackPanel>
				<TextBlock Foreground="#F2F2F2">
					<Run Text="Twitch IRC time since last ping: " /><Run x:Name="IrcAge" />
					<Run Text="  |  Event Sub time since last keepalive: " /><Run x:Name="EventSubAge" />
					<Run Text="  |  StreamElements time since last reply: " /><Run x:Name="StreamElementsAge" />
				</TextBlock>
				<ItemsControl x:Name="NameColorList" Margin="0,3,0,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" Background="Transparent">
								<TextBlock Text="{Binding Separator}" Foreground="#888888" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Label}" Foreground="#B9D6F2" VerticalAlignment="Center" />
								<Border x:Name="Swatch" Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center"
										Background="{Binding Swatch}" BorderBrush="#666666" BorderThickness="1" />
								<TextBlock x:Name="ColorText" Text="{Binding Text}" Foreground="#EEEEEE" Margin="4,0,0,0" VerticalAlignment="Center" />
								<TextBlock x:Name="AgeText" Text="{Binding Age}" Foreground="#CCCCCC" Margin="7,0,0,0" VerticalAlignment="Center" />
								<TextBlock x:Name="NoteText" Text="{Binding Note}" Foreground="{Binding NoteBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
									<Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Text}" Value="">
									<Setter TargetName="ColorText" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Age}" Value="">
									<Setter TargetName="AgeText" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Note}" Value="">
									<Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>

		<Border DockPanel.Dock="Right" Width="440" Background="#141414" BorderBrush="#333333" BorderThickness="1,0,0,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border Grid.Row="0" Padding="6,4" BorderBrush="#333333" BorderThickness="0,0,0,1">
					<ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl x:Name="LeftPanelList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>

				<Border Grid.Row="1" Padding="6,4">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl x:Name="ObsSourcesList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid>
										<DockPanel x:Name="Plain" ToolTip="{Binding ToolTip}" Background="Transparent">
											<Border x:Name="Swatch" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,3,4,0" VerticalAlignment="Top"
													Background="{Binding Swatch}" BorderBrush="#666666" BorderThickness="1" />
											<TextBlock x:Name="PlainText" TextWrapping="Wrap"><Run Text="{Binding Label, Mode=OneWay}" Foreground="{Binding LabelBrush}" /><Run Text="{Binding Rest, Mode=OneWay}" Foreground="{Binding Brush}" /></TextBlock>
										</DockPanel>
										<WrapPanel x:Name="ChipRow" Visibility="Collapsed" Margin="0,1">
											<TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" Width="88" VerticalAlignment="Center" />
											<ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<WrapPanel Orientation="Horizontal" />
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="{Binding ToolTip}" Background="Transparent">
															<Border Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center"
																	Background="{Binding Fill}" BorderBrush="{Binding Edge}" BorderThickness="1" />
															<TextBlock Text="{Binding Code}" Foreground="{Binding CodeBrush}" VerticalAlignment="Center" />
														</StackPanel>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
											<TextBlock Text="{Binding After}" Foreground="#888888" VerticalAlignment="Center" />
										</WrapPanel>
									</Grid>
									<DataTemplate.Triggers>
										<DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
											<Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
										</DataTrigger>
										<DataTrigger Binding="{Binding IsRow}" Value="True">
											<Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
											<Setter TargetName="ChipRow" Property="Visibility" Value="Visible" />
										</DataTrigger>
										<DataTrigger Binding="{Binding IsHeading}" Value="True">
											<Setter TargetName="Plain" Property="Background" Value="#1C2733" />
											<Setter TargetName="Plain" Property="Margin" Value="-6,8,-6,2" />
											<Setter TargetName="PlainText" Property="Margin" Value="6,1" />
											<Setter TargetName="PlainText" Property="FontWeight" Value="Bold" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Right" MinWidth="240" Background="#141414" Padding="6,4" BorderBrush="#333333" BorderThickness="1,0,0,0">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
					<StackPanel x:Name="SplitsHead" Orientation="Horizontal">
						<TextBlock x:Name="SplitsTitle" VerticalAlignment="Center" />
						<ComboBox x:Name="ListChoiceBox" Margin="6,0,6,0" SelectionChanged="ListPicked">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Label}" ToolTip="{Binding ToolTip}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>
					<ComboBox x:Name="ComparisonBox" SelectionChanged="ComparisonPicked">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Label}" ToolTip="{Binding ToolTip}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
				<ItemsControl x:Name="SplitsList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
					<ItemsControl.Template>
						<ControlTemplate TargetType="ItemsControl">
							<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
								<ItemsPresenter />
							</ScrollViewer>
						</ControlTemplate>
					</ItemsControl.Template>
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<VirtualizingStackPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" Background="{Binding Background}">
								<Grid Width="{Binding NameWidth}">
									<TextBlock><Run Text="{Binding Guides, Mode=OneWay}" Foreground="#555555" /><Run Text="{Binding Before, Mode=OneWay}" Foreground="{Binding BeforeBrush}" /><Run Text="{Binding Text, Mode=OneWay}" Foreground="{Binding Brush}" /></TextBlock>
									<TextBlock Text="{Binding Path}" Foreground="#EE8844" IsHitTestVisible="False" />
									<Grid HorizontalAlignment="Left" IsHitTestVisible="False">
										<TextBlock Text="0" Visibility="Hidden" />
										<Ellipse Width="7" Height="7" Fill="{Binding Dot}" />
									</Grid>
								</Grid>
								<TextBlock Text="{Binding Run.Text}" Foreground="{Binding Run.Brush}" Width="{Binding Run.Width}" TextAlignment="Right" />
								<TextBlock Text="{Binding Dots}" Foreground="#444444" />
								<TextBlock Text="{Binding Segment.Text}" Foreground="{Binding Segment.Brush}" Width="{Binding Segment.Width}" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</DockPanel>
		</Border>

		<ListBox x:Name="LogList"
				 Background="Transparent" BorderThickness="0"
				 SelectionMode="Extended"
				 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				 VirtualizingPanel.IsVirtualizing="True"
				 VirtualizingPanel.VirtualizationMode="Recycling">
			<ListBox.CommandBindings>
				<CommandBinding Command="ApplicationCommands.Copy" Executed="CopySelected" />
			</ListBox.CommandBindings>
			<ListBox.ItemContainerStyle>
				<Style TargetType="ListBoxItem">
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Border x:Name="Row" Background="Transparent" Padding="6,0">
									<ContentPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Row" Property="Background" Value="#264F78" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListBox.ItemContainerStyle>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</Window>
