<Window x:Class="StreamAssistant2.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Stream Assistant"
		Icon="/icon.ico"
		Width="1600" Height="900"
		Background="#0C0C0C"
		FontFamily="Consolas" FontSize="13">
	<DockPanel>
		<Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="6,4" BorderBrush="#333333" BorderThickness="0,0,0,1">
			<StackPanel>
				<TextBlock Foreground="#F2F2F2">
					<Run Text="Twitch IRC time since last ping: " /><Run x:Name="IrcAge" />
					<Run Text="  |  Event Sub time since last keepalive: " /><Run x:Name="EventSubAge" />
					<Run Text="  |  StreamElements time since last reply: " /><Run x:Name="StreamElementsAge" />
				</TextBlock>
				<ItemsControl x:Name="NameColorList" Margin="0,3,0,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" Background="Transparent">
								<TextBlock Text="{Binding Separator}" Foreground="#888888" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Label}" Foreground="#B9D6F2" VerticalAlignment="Center" />
								<Border x:Name="Swatch" Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center"
										Background="{Binding Swatch}" BorderBrush="#666666" BorderThickness="1" />
								<TextBlock x:Name="ColorText" Text="{Binding Text}" Foreground="#EEEEEE" Margin="4,0,0,0" VerticalAlignment="Center" />
								<TextBlock x:Name="AgeText" Text="{Binding Age}" Foreground="#CCCCCC" Margin="7,0,0,0" VerticalAlignment="Center" />
								<TextBlock x:Name="NoteText" Text="{Binding Note}" Foreground="{Binding NoteBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
									<Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Text}" Value="">
									<Setter TargetName="ColorText" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Age}" Value="">
									<Setter TargetName="AgeText" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Note}" Value="">
									<Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>

		<Border DockPanel.Dock="Right" Width="360" Background="#141414" Padding="6,4" BorderBrush="#333333" BorderThickness="1,0,0,0">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl x:Name="LeftPanelList">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<Border DockPanel.Dock="Right" Width="440" Background="#141414" Padding="6,4" BorderBrush="#333333" BorderThickness="1,0,0,0">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl x:Name="ObsSourcesList">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid>
								<DockPanel x:Name="Plain" ToolTip="{Binding ToolTip}" Background="Transparent">
									<Border x:Name="Swatch" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,3,4,0" VerticalAlignment="Top"
											Background="{Binding Swatch}" BorderBrush="#666666" BorderThickness="1" />
									<TextBlock x:Name="PlainText" TextWrapping="Wrap"><Run Text="{Binding Label, Mode=OneWay}" Foreground="{Binding LabelBrush}" /><Run Text="{Binding Rest, Mode=OneWay}" Foreground="{Binding Brush}" /></TextBlock>
								</DockPanel>
								<WrapPanel x:Name="ChipRow" Visibility="Collapsed" Margin="0,1">
									<TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" Width="88" VerticalAlignment="Center" />
									<ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="{Binding ToolTip}" Background="Transparent">
													<Border Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center"
															Background="{Binding Fill}" BorderBrush="{Binding Edge}" BorderThickness="1" />
													<TextBlock Text="{Binding Code}" Foreground="{Binding CodeBrush}" VerticalAlignment="Center" />
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="{Binding After}" Foreground="#888888" VerticalAlignment="Center" />
								</WrapPanel>
							</Grid>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
									<Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding IsRow}" Value="True">
									<Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
									<Setter TargetName="ChipRow" Property="Visibility" Value="Visible" />
								</DataTrigger>
								<DataTrigger Binding="{Binding IsHeading}" Value="True">
									<Setter TargetName="Plain" Property="Background" Value="#1C2733" />
									<Setter TargetName="Plain" Property="Margin" Value="-6,8,-6,2" />
									<Setter TargetName="PlainText" Property="Margin" Value="6,1" />
									<Setter TargetName="PlainText" Property="FontWeight" Value="Bold" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<ListBox x:Name="LogList"
				 Background="Transparent" BorderThickness="0"
				 SelectionMode="Extended"
				 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				 VirtualizingPanel.IsVirtualizing="True"
				 VirtualizingPanel.VirtualizationMode="Recycling">
			<ListBox.CommandBindings>
				<CommandBinding Command="ApplicationCommands.Copy" Executed="CopySelected" />
			</ListBox.CommandBindings>
			<ListBox.ItemContainerStyle>
				<Style TargetType="ListBoxItem">
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Border x:Name="Row" Background="Transparent" Padding="6,0">
									<ContentPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Row" Property="Background" Value="#264F78" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListBox.ItemContainerStyle>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</Window>
