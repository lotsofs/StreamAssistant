<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="obs-websocket-dotnet" Version="5.0.1" />
		<PackageReference Include="System.Speech" Version="10.0.7" />
		<PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- UseWPF leaves these out of the implicit usings; the bot's code relies on them. -->
		<Using Include="System.IO" />
		<Using Include="System.Net.Http" />
	</ItemGroup>

	<ItemGroup>
		<!-- Lets the tests reach internal types such as Config. -->
		<InternalsVisibleTo Include="StreamAssistant2.Tests" />
	</ItemGroup>
	
	<Target Name="EnsurePathsJsonExists" BeforeTargets="BeforeBuild">
		<Copy Condition="!Exists('paths.json') and Exists('paths.json.example')"
			  SourceFiles="paths.json.example"
			  DestinationFiles="paths.json" />
	</Target>

</Project>